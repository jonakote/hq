# Copy this file to .env and replace every CHANGE_ME value.
# .env is intentionally gitignored because it contains credentials.

# Match the Linux user that owns /workspace on the VPS.
HERMES_UID=1000
HERMES_GID=1000

# Keep the bind address on loopback and use SSH tunnelling.
HERMES_BIND_ADDRESS=127.0.0.1
HERMES_GATEWAY_HOST_PORT=8642
HERMES_DASHBOARD_HOST_PORT=9119
HERMES_WORKSPACE_DIR=/workspace

# Generate each value with: openssl rand -hex 32
API_SERVER_KEY=CHANGE_ME_generate_a_long_random_value
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes-admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGE_ME_use_a_long_unique_password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=CHANGE_ME_generate_a_long_random_value

# Optional: pin a tested image tag instead of tracking latest.
# HERMES_IMAGE=nousresearch/hermes-agent:latest

# Optional provider credentials. The setup wizard normally stores these in
# hermes/data/.env instead, so do not add them here unless intentional.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

