# Jenkins Master - Environment Variables
# Copy this to .env and customize

# Jenkins version (use 'lts' for Long Term Support or 'latest')
JENKINS_VERSION=lts

# Jenkins home directory on the host
JENKINS_HOME=./jenkins-home

# HTTP port for Jenkins web UI
HTTP_PORT=8080

# Port for agent connections (JNLP/WebSocket)
AGENT_PORT=50000

# Jenkins admin credentials (initial setup only)
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin

# Java options for Jenkins
JAVA_OPTS=-Xmx2g -Xms512m

# Timezone
TZ=UTC

# Enable Docker-in-Docker (for docker-compose.dind.yml)
# DOCKER_HOST=tcp://docker:2376
